# Coturn / TURN Server Configuration Template

# Restart policy for the docker container (e.g. unless-stopped, always)
RESTART_POLICY=unless-stopped

# The public IP address of your server where Coturn is running (required for zero-dependency routing)
SERVERIP=

# The domain name configured for your TURN server (e.g. turn.digi-work.ir)
COTURN_DOMAIN=

# Static auth secret key used to generate TURN credentials.
# Must match the TURN_STATIC_AUTH_SECRET value in your main .env file.
TURN_STATIC_AUTH_SECRET=
